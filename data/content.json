[
{"id":1,"type":"Qur'an","arabic":"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا","translation":"With hardship comes ease.","source":"Qur'an","reference":"94:5"},
{"id":2,"type":"Qur'an","arabic":"وَاذْكُر رَّبَّكَ إِذَا نَسِيتَ","translation":"Remember your Lord when you forget.","source":"Qur'an","reference":"18:24"},
{"id":3,"type":"Qur'an","arabic":"إِنَّ اللَّهَ مَعَ الصَّابِرِينَ","translation":"Allah is with the patient.","source":"Qur'an","reference":"2:153"},
{"id":4,"type":"Qur'an","arabic":"وَمَن يَتَّقِ اللَّهَ يَجْعَل لَّهُ مَخْرَجًا","translation":"Whoever is mindful of Allah, He will make a way out for them.","source":"Qur'an","reference":"65:2"},
{"id":5,"type":"Qur'an","arabic":"وَقُل رَّبِّ زِدْنِي عِلْمًا","translation":"My Lord, increase me in knowledge.","source":"Qur'an","reference":"20:114"},
{"id":6,"type":"Qur'an","arabic":"حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ","translation":"Allah is sufficient for us, and He is the best Trustee.","source":"Qur'an","reference":"3:173"},
{"id":7,"type":"Qur'an","arabic":"إِنَّ مَعَ الْعُسْرِ يُسْرًا","translation":"With hardship comes ease.","source":"Qur'an","reference":"94:6"},
{"id":8,"type":"Qur'an","arabic":"وَاللَّهُ خَيْرُ الرَّازِقِينَ","translation":"Allah is the best of providers.","source":"Qur'an","reference":"62:11"},
{"id":9,"type":"Qur'an","arabic":"وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْ","translation":"He is with you wherever you are.","source":"Qur'an","reference":"57:4"},
{"id":10,"type":"Qur'an","arabic":"وَبَشِّرِ الصَّابِرِينَ","translation":"Give glad tidings to those who are patient.","source":"Qur'an","reference":"2:155"},
{"id":11,"type":"Qur'an","arabic":"لَا تَقْنَطُوا مِن رَّحْمَةِ اللَّهِ","translation":"Do not despair of the mercy of Allah.","source":"Qur'an","reference":"39:53"},
{"id":12,"type":"Qur'an","arabic":"وَلَا تَيْأَسُوا مِن رَّوْحِ اللَّهِ","translation":"Do not despair of relief from Allah.","source":"Qur'an","reference":"12:87"},
{"id":13,"type":"Qur'an","arabic":"إِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ","translation":"Allah loves those mindful of Him.","source":"Qur'an","reference":"3:76"},
{"id":14,"type":"Qur'an","arabic":"إِنَّ اللَّهَ مَعَ الْمُحْسِنِينَ","translation":"Allah is with those who do good.","source":"Qur'an","reference":"29:69"},
{"id":15,"type":"Qur'an","arabic":"فَاذْكُرُونِي أَذْكُرْكُمْ","translation":"Remember Me; I will remember you.","source":"Qur'an","reference":"2:152"},
{"id":16,"type":"Qur'an","arabic":"وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ","translation":"Be grateful to Me and do not deny Me.","source":"Qur'an","reference":"2:152"},
{"id":17,"type":"Qur'an","arabic":"وَقُولُوا لِلنَّاسِ حُسْنًا","translation":"Speak kindly to people.","source":"Qur'an","reference":"2:83"},
{"id":18,"type":"Qur'an","arabic":"إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ","translation":"Allah loves those who turn back to Him.","source":"Qur'an","reference":"2:222"},
{"id":19,"type":"Qur'an","arabic":"رَبَّنَا تَقَبَّلْ مِنَّا","translation":"Our Lord, accept this from us.","source":"Qur'an","reference":"2:127"},
{"id":20,"type":"Qur'an","arabic":"رَبِّ اشْرَحْ لِي صَدْرِي","translation":"My Lord, expand my breast for me.","source":"Qur'an","reference":"20:25"},
{"id":21,"type":"Qur'an","arabic":"رَبِّ أَنزِلْنِي مُنزَلًا مُّبَارَكًا","translation":"My Lord, let me land at a blessed place.","source":"Qur'an","reference":"23:29"},
{"id":22,"type":"Qur'an","arabic":"وَتَوَكَّلْ عَلَى اللَّهِ","translation":"Put your trust in Allah.","source":"Qur'an","reference":"33:3"},
{"id":23,"type":"Qur'an","arabic":"وَاللَّهُ غَالِبٌ عَلَىٰ أَمْرِهِ","translation":"Allah prevails over His affair.","source":"Qur'an","reference":"12:21"},
{"id":24,"type":"Qur'an","arabic":"إِنَّ رَبِّي لَسَمِيعُ الدُّعَاءِ","translation":"My Lord is certainly the Hearer of prayer.","source":"Qur'an","reference":"14:39"},
{"id":25,"type":"Qur'an","arabic":"وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ","translation":"My mercy encompasses all things.","source":"Qur'an","reference":"7:156"},
{"id":26,"type":"Qur'an","arabic":"إِنَّ اللَّهَ لَغَفُورٌ رَّحِيمٌ","translation":"Allah is surely Forgiving, Merciful.","source":"Qur'an","reference":"2:173"},
{"id":27,"type":"Qur'an","arabic":"وَلَا تَهِنُوا وَلَا تَحْزَنُوا","translation":"Do not lose heart or grieve.","source":"Qur'an","reference":"3:139"},
{"id":28,"type":"Qur'an","arabic":"فَاسْتَبِقُوا الْخَيْرَاتِ","translation":"Race toward good deeds.","source":"Qur'an","reference":"2:148"},
{"id":29,"type":"Qur'an","arabic":"إِنَّ اللَّهَ مَعَ الصَّابِرِينَ","translation":"Allah is with the patient.","source":"Qur'an","reference":"8:46"},
{"id":30,"type":"Qur'an","arabic":"وَاصْبِرْ وَمَا صَبْرُكَ إِلَّا بِاللَّهِ","translation":"Be patient; your patience is only through Allah.","source":"Qur'an","reference":"16:127"},
{"id":31,"type":"Qur'an","arabic":"رَبَّنَا لَا تُزِغْ قُلُوبَنَا","translation":"Our Lord, do not let our hearts deviate.","source":"Qur'an","reference":"3:8"},
{"id":32,"type":"Qur'an","arabic":"رَبِّ هَبْ لِي مِن لَّدُنكَ رَحْمَةً","translation":"My Lord, grant me mercy from Yourself.","source":"Qur'an","reference":"18:10"},
{"id":33,"type":"Qur'an","arabic":"وَأَحْسِن كَمَا أَحْسَنَ اللَّهُ إِلَيْكَ","translation":"Do good as Allah has done good to you.","source":"Qur'an","reference":"28:77"},
{"id":34,"type":"Qur'an","arabic":"إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ","translation":"Allah loves those who do good.","source":"Qur'an","reference":"2:195"},
{"id":35,"type":"Qur'an","arabic":"وَقُل رَّبِّ اغْفِرْ وَارْحَمْ","translation":"Say: My Lord, forgive and have mercy.","source":"Qur'an","reference":"23:118"},
{"id":36,"type":"Qur'an","arabic":"رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا","translation":"Our Lord, pour upon us patience.","source":"Qur'an","reference":"2:250"},
{"id":37,"type":"Qur'an","arabic":"لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا","translation":"Allah does not burden a soul beyond its capacity.","source":"Qur'an","reference":"2:286"},
{"id":38,"type":"Qur'an","arabic":"إِنَّ اللَّهَ خَبِيرٌ بِمَا تَعْمَلُونَ","translation":"Allah is fully aware of what you do.","source":"Qur'an","reference":"2:234"},
{"id":39,"type":"Qur'an","arabic":"سَيَجْعَلُ اللَّهُ بَعْدَ عُسْرٍ يُسْرًا","translation":"Allah will bring about ease after hardship.","source":"Qur'an","reference":"65:7"},
{"id":40,"type":"Qur'an","arabic":"وَإِلَىٰ رَبِّكَ فَارْغَب","translation":"Turn your hopes toward your Lord.","source":"Qur'an","reference":"94:8"}
]
